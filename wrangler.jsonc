{
  "name": "dispatch-api-client",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__proxy*"]
  }
}
